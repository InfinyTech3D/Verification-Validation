{
  "geometry":    { "type": "Beam3D", "length": 1.0, "width": 1.0, "height": 1.0 },
  "element":     "tet",
  "material":    { "type": "LinearElastic", "youngModulus": 1e6, "poissonRatio": 0.3 },
  "forceField":  { "type": "CorotationalFEMForceField", "rotationMethod": "polar" },
  "tractionOn":  { "right": [1, 1, 1], "left": [1, 1, 1], "top": [1, 1, 1] },
  "solution":    { "type": "Trigonometric", "amplitude": 0.02 },
  "errorQuadratureDegree": 2,
  "sourceQuadratureDegree": 2,
  "rotation":    { "axis": "z", "angleDegreesPerLength": { "x": 3.75, "y": 2.5 } },
  "solvers": {
    "integration":  { "type": "StaticEquilibriumIntegrationScheme", "maxNbIterationsNewton": 40,
                      "maxNbIterationsLineSearch": 5,
                      "residueThreshold": 1e-14, "alwaysAdvanceNewton": true,
                      "printLog": true },
    "linearSolver": {
      "type": "EigenBiCGSTAB", "template": "CompressedRowSparseMatrixd",
      "iterations": 3000, "tolerance": 1e-10, "printLog": true,
      "preconditioner": "IncompleteLUT", "fillFactor": 10, "dropTolerance": 1e-3
    }
  },
  "gridMapping": { "swapping": true },
  "mesh":        { "cells": [3, 3, 3], "levels": 5, "refinementRatio": 2 },
  "asymptoticTolerance": 0.10,
  "expectedOrder": { "L2": 2.0, "H1": 1.0, "CauchyStress": 1.0, "EnergyDifference": 1.0 },
  "expectedOrderTolerance": 0.15,
  "relativeNoiseFloor": 1e-10
}
