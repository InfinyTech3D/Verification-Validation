{
  "geometry":    { "type": "Beam3D", "length": 1.0, "width": 1.0, "height": 1.0 },
  "element":     "hexa",
  "material":    { "type": "LinearElastic", "youngModulus": 1e6, "poissonRatio": 0.3 },
  "forceField":  { "type": "CorotationalFEMForceField", "rotationMethod": "polar" },
  "solution":    { "type": "Trigonometric", "amplitude": 0.02 },
  "compareAgainst": "LinearSmallStrainFEMForceField/Trigonometric3D_Hexa_Dirichlet",
  "agreementTolerance": 1e-2,
  "errorQuadratureDegree": 3,
  "sourceQuadratureDegree": 3,
  "rotation":    { "angleDegrees": 45.0, "axis": "z" },
  "excitationSteps": 3,
  "solvers": {
    "integration":  { "type": "StaticSolver" },
    "newton":       { "type": "NewtonRaphsonSolver", "maxNbIterationsNewton": 40,
                      "maxNbIterationsLineSearch": 5,
                      "relativeInitialStoppingThreshold": 1e-8,
                      "relativeSuccessiveStoppingThreshold": 0,
                      "absoluteResidualStoppingThreshold": 0,
                      "printLog": false },
    "linearSolver": {
      "type": "PCGLinearSolver", "iterations": 1000, "tolerance": 1e-24, "printLog": false,
      "system": { "type": "PreconditionedMatrixFreeSystem" },
      "preconditioner": {
        "type": "SSORPreconditioner",
        "system": { "type": "MatrixLinearSystem", "template": "CompressedRowSparseMatrixd" }
      }
    }
  },
  "mesh":        { "cells": [3, 3, 3], "levels": 5, "refinementRatio": 2 },
  "asymptoticTolerance": 0.10,
  "expectedOrder": { "L2": 2.0, "H1": 1.0, "EnergyDifference": 1.0 },
  "expectedOrderTolerance": 0.15,
  "relativeNoiseFloor": 1e-10
}
