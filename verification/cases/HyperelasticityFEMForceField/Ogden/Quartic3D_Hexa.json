{
  "geometry":    { "type": "Tyre3D", "inner_radius": 0.25, "outer_radius": 0.5, "extrusion_length": 0.25 },
  "element":     "hexa",
  "material":    { "type": "Ogden", "mu": 8e5, "alpha": 4, "kappa": 8e5 },
  "forceField":  { "type": "HyperelasticityFEMForceField" },
  "tractionOn":  { "front": [1, 1, 1], "back": [1, 1, 1] },
  "solution":    { "type": "Quartic", "amplitude": 0.1 },
  "excitationSteps": 1,
  "errorQuadratureDegree": 3,
  "sourceQuadratureDegree": 3,
  "solvers": {
    "integration":  { "type": "StaticEquilibriumIntegrationScheme", "maxNbIterationsNewton": 10,
                      "residualThreshold": 1e-14, "alwaysAdvanceNewton": true,
                      "printLog": true },
    "linearSolver": {
      "type": "PCGLinearSolver", "iterations": 1000, "tolerance": 1e-24, "printLog": false,
      "system": { "type": "PreconditionedMatrixFreeSystem" },
      "preconditioner": {
        "type": "SSORPreconditioner",
        "system": { "type": "MatrixLinearSystem", "template": "CompressedRowSparseMatrixd" }
      }
    }
  },
  "mesh":        { "cells": [2, 16, 2], "levels": 4, "refinementRatio": 2 },
  "asymptoticTolerance": 0.10,
  "expectedOrder": { "L2": 2.0, "H1": 1.0, "CauchyStress": 1.0, "EnergyDifference": 1.0 },
  "expectedOrderTolerance": 0.15,
  "relativeNoiseFloor": 1e-10
}
