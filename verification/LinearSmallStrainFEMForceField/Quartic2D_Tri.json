{
  "geometry":    { "type": "Tire2D", "inner_radius": 0.25, "outer_radius": 0.5 },
  "element":     "tri",
  "quadratureDegree": 2,
  "sourceQuadratureDegree": 2,
  "material":    { "type": "LinearElastic", "youngModulus": 1.0, "poissonRatio": 0.3 },
  "forceField":  { "type": "LinearSmallStrainFEMForceField" },
  "solvers": {
    "integration":  { "type": "StaticSolver" },
    "newton":       { "type": "NewtonRaphsonSolver", "maxNbIterationsNewton": 1,
                      "relativeInitialStoppingThreshold": 1e-6,
                      "relativeSuccessiveStoppingThreshold": 0,
                      "absoluteResidualStoppingThreshold": 0 },
    "linearSolver": {
      "type": "PCGLinearSolver", "iterations": 1000, "tolerance": 1e-24,
      "system": { "type": "PreconditionedMatrixFreeSystem" },
      "preconditioner": {
        "type": "SSORPreconditioner",
        "system": { "type": "MatrixLinearSystem", "template": "CompressedRowSparseMatrixd" }
      }
    }
  },
  "mesh":        { "cells": [2, 16], "levels": 5, "refinementRatio": 2 },
  "asymptoticTolerance": 0.10,
  "expectedOrder": { "L2": 2.0, "H1": 1.0, "EnergyDifference": 1.0 },
  "expectedOrderTolerance": 0.15,
  "relativeNoiseFloor": 1e-10,
  "tractionOn":  { "outer": [1, 1] },
  "solution":    { "type": "Quartic", "amplitude": 1.0 }
}
