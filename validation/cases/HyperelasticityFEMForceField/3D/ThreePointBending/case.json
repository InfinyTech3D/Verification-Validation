{
  "SaintVenantKirchhoff_hexa": {
    "geometry":   { "type": "Beam3D", "length": 1.0, "width": 0.2, "height": 0.2 },
    "element":    "hexa",
    "material":   { "type": "SaintVenantKirchhoff", "youngModulus": 1000.0, "poissonRatio": 0.3 },
    "forceField": { "type": "HyperelasticityFEMForceField" },
    "solvers": {
      "integration":  { "type": "StaticSolver" },
      "newton":       { "type": "NewtonRaphsonSolver", "maxNbIterationsNewton": 20,
                        "relativeInitialStoppingThreshold": 1e-10,
                        "relativeSuccessiveStoppingThreshold": 0,
                        "absoluteResidualStoppingThreshold": 1e-12,
                        "warnWhenLineSearchFails": false },
      "linearSolver": { "type": "SparseLDLSolver", "template": "CompressedRowSparseMatrixd" }
    },
    "mesh":       { "resolution": [11, 5, 5] },
    "load":       { "type": "concentratedTransverseForce", "magnitude": 0.25, "steps": 5 },
    "tolerance":  { "rms": 1e-6 }
  },
